#!/usr/bin/env bash
# Barriere rapide avant commit sur tout le workspace.
# Contournement ponctuel : git commit --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

# Trouve par l'audit du 8 septembre 2026 : les verifications ci-dessous portent
# sur l'arbre de travail, pas sur l'index. Avec un ajout partiel (git add -p, ou
# un fichier modifie apres git add) l'index differe de l'arbre : le hook pouvait
# etre vert alors que le commit produit ne compilait pas (le hunk non indexe
# portait la definition appelee par les hunks indexes, CI rouge sur main), et a
# l'inverse refuser un commit sain a cause de travail non indexe ailleurs.
# On ne remise PAS l'arbre pour isoler l'index : `git stash --keep-index` puis
# `git stash pop` corrompt l'arbre justement dans le cas de l'ajout partiel (le
# pop rejoue la 3e modif contre l'index a 2 hunks et laisse des marqueurs de
# conflit <<<<<<< dans le fichier suivi) — verifie a l'audit, perte de travail
# inacceptable dans une barriere rapide. Le hook refuse donc le commit quand
# l'index differe de l'arbre suivi, en expliquant pourquoi : il ne rend un
# verdict que lorsqu'il peut valider exactement ce qui sera commite.
if ! git diff --quiet; then
  echo "✗ pre-commit : l'index differe de l'arbre de travail (ajout partiel," >&2
  echo "  ou fichier modifie apres 'git add'). Le hook verifie l'arbre : son" >&2
  echo "  verdict ne refleterait pas le commit produit (faux vert possible)." >&2
  echo "  Indexe tout ('git add -u' ou 'git add .') puis recommence, ou" >&2
  echo "  contourne par 'git commit --no-verify' en t'appuyant sur ./check.sh." >&2
  exit 1
fi

# Trouvé par l'audit du 9 septembre 2026 : la porte etait lente deux fois. Quand
# check.sh vient d'etre vert sur cet arbre exactement (temoin ecrit par lui,
# empreinte de scripts/temoin-arbre.sh : HEAD, differences suivies, fichiers
# non suivis), rejouer clippy, tests, sidecar et front ne prouverait rien de
# plus. Le moindre changement depuis donne une autre empreinte, et tout est
# rejoue. La garde index/arbre ci-dessus reste premiere : le temoin decrit
# l'arbre, et le commit doit etre l'arbre.
if [ -f .git/avash-temoin-check ] && [ -x scripts/temoin-arbre.sh ] \
   && [ "$(cat .git/avash-temoin-check)" = "$(scripts/temoin-arbre.sh)" ]; then
  echo "✓ pre-commit : arbre identique a celui que check.sh vient de valider, rien a rejouer"
  exit 0
fi

echo "▸ pre-commit : garde front"
./scripts/guard.sh
echo "▸ pre-commit : format"
cargo fmt --all --check
echo "▸ pre-commit : clippy"
cargo clippy --workspace --all-targets -- -D warnings
echo "▸ pre-commit : tests"
cargo test --workspace --all-targets
# Le sidecar RDP est hors du workspace : sans cette ligne, ses tests — dont le
# TOFU de certificat — ne passaient par aucune porte.
echo "▸ pre-commit : processus RDP"
(cd rdp-sidecar && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test && ./verifier-portes.sh)
# Les trois etapes front les plus rapides. Elles manquaient : un typage ou un
# test front casse se commitait sans resistance et ne rougissait qu'en CI,
# alors que le hook faisait tourner la plus lente des etapes Rust.
echo "▸ pre-commit : front"
(cd web && npx tsc --noEmit && npx eslint . && npx stylelint index.html && npx knip && npx vitest run --silent)
